    "Pick a custom image for the Launchpad tile. Defaults to the system Launchpad icon.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen personalizada para el ícono de Launchpad. Por defecto utiliza el ícono de Launchpad del sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为启动台图块选择自定义图像。默认使用系统启动台图标。"
          }
        }
      }
    },
    "Pick a custom image for the Start Menu tile. Defaults to Docky's own app icon.": {
      "comment": "A label describing the option to set a custom image for the Start Menu tile.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为开始菜单图块选择自定义图像。默认使用 Docky 自带的应用图标。"
          }
        }
      }
    },
    "Pick an image to render behind the Launchpad grid. When unset, Docky uses the current desktop wallpaper. Combined with the transparency slider for the dim overlay above it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张图像渲染在启动台网格背后。未设置时，Docky 会使用当前桌面壁纸。可与上方的透明度滑块配合，用于其上方的暗色叠加层。"
          }
        }
      }
    },
    "Pick custom images for any folder tile currently in the dock. Each folder defaults to its system icon.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige imágenes personalizadas para cualquier ícono de carpeta del dock. Cada carpeta usa su ícono del sistema por defecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Dock 中当前的任意文件夹图块选择自定义图像。每个文件夹默认使用其系统图标。"
          }
        }
      }
    },
    "Pick custom images for the Trash tile's empty and full states. Both default to the system Trash icons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige imágenes personalizadas para los estados vacío y lleno del ícono de Papelera. Ambos usan los íconos de Papelera del sistema por defecto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为废纸篓图块的空和满两种状态选择自定义图像。两者默认使用系统废纸篓图标。"
          }
        }
      }
    },
    "Pick one from the Marketplace above or install a `.dockywidget` file manually.": {
      "comment": "A description below the \"Installed Widgets\" section, explaining that users can either install widgets from the marketplace or manually by dragging a `.dockywidget` file onto the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上面的市场中选择一个，或手动安装 `.dockywidget` 文件。"
          }
        }
      }
    },
    "Pill": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Píldora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胶囊"
          }
        }
      }
    },
    "Pin the active theme's icon for this app as your override. Without this, the theme icon already applies; pinning it preserves the choice if you switch themes.": {
      "comment": "A help text explaining how to use the \"Use Theme Icon\" button.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前主题的图标固定为此 App 的覆盖图标。不固定时主题图标也会生效；固定后即使切换主题也会保留此选择。"
          }
        }
      }
    },
    "Pin this widget to a city, or use the device's current location.": {
      "comment": "A description of the location selection options.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此小组件固定到某个城市，或使用设备当前位置。"
          }
        }
      }
    },
    "Placement": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置"
          }
        }
      }
    },
    "Placement, visibility, app-tile click, app folders, widgets, launch, and system-dock settings will return to their defaults. Appearance, app icons, and other settings are unaffected. This cannot be undone.": {
      "comment": "A message displayed in the confirmation dialog within the \"Behavior\" section of the `BehaviorSettingsView`.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置、可见性、应用图块点击、应用文件夹、小组件、启动和系统 Dock 设置都将恢复默认值。外观、应用图标和其他设置不受影响。此操作无法撤销。"
          }
        }
      }
    },
    "Play/Pause": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir/Pausar"
          }
        },
