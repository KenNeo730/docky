{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "%@ is required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要%@"
          }
        }
      },
      "comment": "Loaded through L10n.text(_:) from a String-based API (NSAlert, NSMenuItem, help, accessibility)."
    },
    "%@ s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒"
          }
        }
      }
    },
    "%@ will be removed from disk. It will keep running until you restart Docky.": {
      "comment": "A message in an alert that appears when a user attempts to install a `.dockywidget` bundle but the bundle is invalid or malformed.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将从磁盘中移除。在你重新启动 Docky 之前，它仍会继续运行。"
          }
        }
      }
    },
    "%@ • %@": {
      "comment": "A subheading that includes the author's name and the version of the widget. The first argument is the author's name. The second argument is the version of the widget.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ • %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ • %@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A stepper that lets the user adjust the number of columns in the Launchpad grid. The value shown is the current number of columns, and the stepper ranges from 1 to 12.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "A text label displaying the current value of a slider. The text inside the label is generated by interpolating the slider's value.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 磅"
          }
        }
      }
    },
    "%lld variants": {
      "comment": "A text label showing the number of variants available for a given item in the gallery. The argument is the number of variants for the item.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个变体"
          }
        }
      }
    },
    "%lld%%": {
      "comment": "A text label showing the current padding",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "%lld°": {
      "comment": "A temperature value displayed in the weather widget forecast. The argument is the temperature in degrees Celsius, rounded to the nearest whole number.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld°"
          }
        }
      }
    },
    "(minimized)": {
      "comment": "Appends \"(minimized)\" to the window title if the window is currently minimized.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（已最小化）"
          }
        }
      }
    },
    "1 variant": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个变体"
          }
        }
      }
    },
    "ALPHA": {
      "comment": "The text that appears as a badge indicating an alpha feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ALPHA"
          }
        }
      }
    },
    "About Actions": {
      "comment": "A section header describing the purpose of actions in Docky.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于操作"
          }
        }
      }
    },
    "About Docky": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de Docky"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Docky"
          }
        }
      }
    },
    "Access Via": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceder vía"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问方式"
          }
        }
      }
    },
    "Action Keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作快捷键"
          }
        }
      }
    },
    "Action kinds Docky will execute: built-in commands, AppleScript, and macOS menu-bar clicks. The first time an app-targeted AppleScript or menu-click action runs, macOS may prompt for Automation permission.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 将执行的操作类型：内置命令、AppleScript 和 macOS 菜单栏点击。首次运行针对某个应用的 AppleScript 或菜单点击操作时，macOS 可能会请求“自动化”权限。"
          }
        }
      }
    },
    "Actions are menu items Docky injects into each tile's right-click menu. A catalog package ships a curated bundle of them; once it's loaded, every action it defines is automatically available on the matching tile type. Apps, folders, the Trash, the Launchpad, and the divider all get their own set, with no per-tile setup needed.": {
      "comment": "A description of how actions are integrated into Docky.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作是 Docky 注入到每个图块右键菜单中的菜单项。目录包会随附一组精选操作；加载后，其中定义的所有操作会自动出现在对应的图块类型上。应用、文件夹、废纸篓、启动台和分隔栏都有各自的一套，无需逐个图块设置。"
          }
        }
      }
    },
