    "Sets the Launchpad grid dimensions. Docky uses these counts when the icons fit on screen, defaulting to 7 columns × 5 rows.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define las dimensiones de la cuadrícula de Launchpad. Docky usa estos valores cuando los íconos caben en pantalla, con 7 columnas × 5 filas por defecto."
