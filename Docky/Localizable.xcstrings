    "Shown when the Trash has items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中有内容时显示。"
          }
        }
      }
    },
    "Shown when the Trash is empty.": {
      "comment": "A description of what happens when the Trash is empty.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓为空时显示。"
          }
        }
      }
    },
    "Shows CPU, memory, and network activity at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la actividad de CPU, memoria y red de un vistazo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地显示 CPU、内存和网络活动。"
          }
        }
      }
    },
    "Shows Grouped Opened Apps In Dock": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apps abiertas agrupadas en el dock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 中分组显示已打开的应用"
          }
        }
      }
    },
    "Shows Grouping Backdrop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar fondo de agrupación"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示分组背景"
          }
        }
      }
    },
    "Shows Mac and accessory battery levels at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los niveles de batería del Mac y los accesorios de un vistazo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地显示 Mac 和配件的电池电量。"
          }
        }
      }
    },
    "Shows a fullscreen launcher with all installed apps on a blurred backdrop.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un lanzador a pantalla completa con todas las apps instaladas sobre un fondo desenfocado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示全屏启动器，所有已安装的应用置于模糊背景之上。"
          }
        }
      }
    },
    "Shows current weather for your location.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el clima actual de tu ubicación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你所在位置的当前天气。"
          }
        }
      }
    },
    "Shows running apps from an app folder immediately to the right of that folder, and lets the folder reflect how many grouped apps are open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las apps en ejecución de una carpeta de apps justo a la derecha de esa carpeta y permite que la carpeta refleje cuántas apps agrupadas están abiertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用文件夹紧右侧的区域内显示该文件夹中正在运行的应用，并让文件夹反映已打开的分组应用数量。"
          }
        }
      }
    },
    "Shows the current date and month at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la fecha y el mes actuales de un vistazo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地显示当前日期和月份。"
          }
        }
      }
    },
    "Shows the currently playing media with quick playback control.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el contenido que se está reproduciendo con controles rápidos de reproducción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前播放的媒体，并提供快捷播放控制。"
          }
        }
      }
    },
    "Shows the weekday and date number at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el día de la semana y el número del día de un vistazo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地显示星期和日期数。"
          }
        }
      }
    },
    "Shows your open tasks and what needs attention next.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus tareas abiertas y lo que necesita atención a continuación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你未完成的任务以及接下来需要处理的事项。"
          }
        }
      }
    },
    "Shows your own photos, cycling through them as a slideshow.": {
      "comment": "Title of an example photo frame widget.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你自己的照片，并以幻灯片方式轮播。"
          }
        }
      }
    },
    "Shrinks the rendered icon inside each tile without changing the tile's layout box. Useful for Windows-style chunky tile slots.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不改变图标布局框的前提下，缩小每个图标内渲染的图标。适用于 Windows 风格的粗块图标槽位。"
          }
        }
      }
    },
    "Single-key shortcuts that fire while the switcher is open and you're still holding its modifier. Re-bind to any key; navigation keys (Tab, arrows, Escape, Return) always win over a conflicting binding.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在切换器打开且你仍按住修饰键时生效的单键快捷键。可重新绑定到任意按键；导航键（Tab、方向键、Escape、Return）始终优先于冲突的绑定。"
          }
        }
      }
    },
    "Size": {
      "comment": "Title of the sorting option for files based on size.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        }
      }
    },
    "Slide Docky off-screen while a maximized window is on its display, with edge-dwell to reveal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza Docky fuera de la pantalla mientras hay una ventana maximizada en su pantalla, con espera en el borde para mostrarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当最大化窗口位于 Docky 所在显示器上时，将 Docky 滑出屏幕，可将指针停在边缘唤出。"
          }
        }
      }
    },
    "Slides Docky's window off-screen until the pointer reaches its edge. Hide timing is controlled by Docky's own delay below, so hiding the system Dock does not stretch it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza la ventana de Docky fuera de la pantalla hasta que el puntero llegue a su borde. El tiempo de ocultación se controla con el retraso propio de Docky abajo, por lo que ocultar el Dock del sistema no lo amplía."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Docky 的窗口滑出屏幕，直到指针触及边缘。隐藏时机由下面的 Docky 自身延迟控制，因此隐藏系统 Dock 不会延长该延迟。"
          }
        }
      }
    },
    "Smart Organize Pinned Items": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organización inteligente de elementos fijados"
