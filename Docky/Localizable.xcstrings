    "All calendars are shown when none are selected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何日历时，将显示所有日历。"
          }
        }
      }
    },
    "All conditions": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las condiciones"
          }
